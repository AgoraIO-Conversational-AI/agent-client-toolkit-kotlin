<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="16dp">

    <LinearLayout
        android:id="@+id/llChatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChatModeText"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/selector_chat_mode_selected"
                android:letterSpacing="0"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="Text"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:backgroundTint="@null"
                app:cornerRadius="8dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_message_text"
                app:iconGravity="textStart"
                app:iconPadding="3dp"
                app:iconSize="13dp"
                app:iconTint="@color/white" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChatModeImage"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/selector_chat_mode_unselected"
                android:letterSpacing="0"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="Image"
                android:textAllCaps="false"
                android:textColor="@color/text_subtitle"
                android:textSize="12sp"
                app:backgroundTint="@null"
                app:cornerRadius="8dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_image"
                app:iconGravity="textStart"
                app:iconPadding="3dp"
                app:iconSize="13dp"
                app:iconTint="@color/text_subtitle" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChatModeSpeak"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/selector_chat_mode_unselected"
                android:letterSpacing="0"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="Speak"
                android:textAllCaps="false"
                android:textColor="@color/text_subtitle"
                android:textSize="12sp"
                app:backgroundTint="@null"
                app:cornerRadius="8dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_message_text"
                app:iconGravity="textStart"
                app:iconPadding="3dp"
                app:iconSize="13dp"
                app:iconTint="@color/text_subtitle" />

            <Space
                android:layout_width="6dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChatModeThink"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/selector_chat_mode_unselected"
                android:letterSpacing="0"
                android:minWidth="0dp"
                android:paddingHorizontal="4dp"
                android:text="Think"
                android:textAllCaps="false"
                android:textColor="@color/text_subtitle"
                android:textSize="12sp"
                app:backgroundTint="@null"
                app:cornerRadius="8dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_message_text"
                app:iconGravity="textStart"
                app:iconPadding="3dp"
                app:iconSize="13dp"
                app:iconTint="@color/text_subtitle" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowMessagePriority"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Priority"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatSpinner
            android:id="@+id/spinnerMessagePriority"
            android:layout_width="160dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_message_input"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llThinkOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="While listening"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinnerThinkListening"
                android:layout_width="160dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_message_input"
                android:paddingHorizontal="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="While thinking"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinnerThinkThinking"
                android:layout_width="160dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_message_input"
                android:paddingHorizontal="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="While speaking"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/spinnerThinkSpeaking"
                android:layout_width="160dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_message_input"
                android:paddingHorizontal="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Include demo metadata"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchThinkMetadata"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="48dp"
                android:showText="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowMessageInterruptable"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Interruptable"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchMessageInterruptable"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="48dp"
            android:showText="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llChatInputRow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_message_input"
            android:hint="Type a message"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp"
            tools:text="Hello" />

        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendChatMessage"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/selector_button_manual"
            android:letterSpacing="0"
            android:minWidth="0dp"
            android:text="Send"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="8dp"
            app:elevation="0dp"
            app:rippleColor="#33FFFFFF" />
    </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
